# Base URL used by MCP clients and cross-origin integrations.
DEV_MUSIC_BASE_URL=http://127.0.0.1:8000

# Optional deployment origins when frontend, backend, and MCP are separated.
DEV_MUSIC_FRONTEND_ORIGIN=*
DEV_MUSIC_BACKEND_ORIGIN=
DEV_MUSIC_MCP_ORIGIN=

# Directory for runtime state such as focus_profile.json.
DMS_DATA_DIR=.

# Optional JavaScript runtime hint for yt-dlp extractors.
YTDLP_JS_RUNTIME=node

# Optional LRCLIB User-Agent override.
LRCLIB_USER_AGENT=dev-music-service/1.0 (lyrics integration; contact: unset)

# CaptionLocalizer must run as a separate service from dev-music-service.
# dev-music-service calls its lyrics-native /tools/localize_lyrics/run tool.
# If dev-music-service is on :8000, run CaptionLocalizer on :8001, for example:
#   python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8001
CAPTION_LOCALIZER_URL=http://127.0.0.1:8001
CAPTION_AUDIO_SOURCE_BASE_URL=http://127.0.0.1:8000
LYRICS_SOURCE_LOCALE=auto
LYRICS_LOCALIZE_WINDOW=6
LYRICS_LOCALIZE_BACKGROUND_FILL=true

# Spotify OAuth configuration.
# Get these from your app at https://developer.spotify.com/dashboard. The
# redirect URI must match one registered there exactly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/import/spotify/callback

# Set by Vercel. Local development should leave this unset or false.
VERCEL=false

# Optional token required for process/host-affecting routes.
DMS_CONTROL_AUTH_TOKEN=

# Comma-separated media host suffix allowlist for /stream proxy targets.
# Whitespace around entries is trimmed; leave unset to use the default list.
STREAM_ALLOWED_HOSTS=googlevideo.com,youtube.com,youtu.be,ytimg.com,ggpht.com,googleusercontent.com

# /stream delivery: proxy preserves current behavior; redirect returns a 302 to the resolved media URL.
STREAM_DELIVERY_MODE=proxy

# Focus profile persistence: local-json is implemented; kv is a provider stub for serverless wiring.
FOCUS_PROFILE_STORAGE_BACKEND=local-json
FOCUS_PROFILE_KV_NAMESPACE=

# ReccoBeats audio-feature lookup (keyless; override for a local proxy).
RECCOBEATS_API_BASE_URL=https://api.reccobeats.com/v1

# Phase · Field shader distribution API, fronted by the /api/shaders proxy.
# Point at the local worker (npm run dev) or a deployed Cloudflare Workers URL.
PHASE_FIELD_API_BASE_URL=http://localhost:8787

# HistoryKit Component Vault, reached by the Canvas editor's /component command.
# Both are localhost-only developer services: when they are absent the command
# reports an unreachable vault and nothing else changes.
COMPONENT_VAULT_MCP_URL=http://127.0.0.1:8766/mcp
COMPONENT_VAULT_PREVIEW_URL=http://127.0.0.1:4174

# Apple Music / MusicKit on the Web. Generate an ES256 developer token in the
# Apple Developer portal and restrict its origin claim to your app origins.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=ca
APPLE_MUSIC_APP_NAME=Phase Field
APPLE_MUSIC_APP_BUILD=0.4.0
# Optional persistent read-only library source (.json or Music/iTunes Library.xml).
APPLE_MUSIC_IMPORT_PATH=

# Optional translated vocal synthesis backend. The /api/vocals/translated route
# sends timed translated lyric segments here and expects audio_url values back.
# Only neutral, user-consented, or licensed voice profiles are supported.
# Pika profile management is pre-release and excluded from production unless
# explicitly enabled here and in the Vercel build environment.
PIKA_VOICE_PROFILE_ENABLED=false
PIKAPROJBACKEND_URL=
PIKAPROJBACKEND_TTS_PATH=/api/tts/segments
TRANSLATED_VOCALS_VOICE_MODE=neutral
TRANSLATED_VOCALS_VOICE_PROFILE_ID=
TRANSLATED_VOCALS_VOICE_CONSENT_TOKEN=
TRANSLATED_VOCALS_LOCAL_SAY_FALLBACK=true
TRANSLATED_VOCALS_SAY_COMMAND=/usr/bin/say
TRANSLATED_VOCALS_SAY_VOICE=
TRANSLATED_VOCALS_FFMPEG_COMMAND=/opt/homebrew/bin/ffmpeg
TRANSLATED_VOCALS_AUDIO_DIR=
